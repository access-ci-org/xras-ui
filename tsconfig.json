{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "allowJs": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    // Needed for the `node:*` imports/globals in src/test/setup.ts (polyfills
    // sourced from Node itself). Other packages' types (react, vite/client,
    // testing-library, ...) are picked up via normal import/reference
    // resolution and aren't affected by this list.
    "types": ["node"]
  },
  "include": ["src"]
}
